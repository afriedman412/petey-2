      contested: no caption could be verified at the widget
    x_petey_review:
      model: claude-opus-5
      changed:
      - description
      - name
      reason: Current name names a section heading, not a value, and cannot tell a
        reader what to write. The caption printed for this wide line is 'If yes, describe:'
        following the lodging/tips question; the publisher tooltip is merely the section
        title copied in.
      before:
        type: string
        semantic_type: text
        description: D. YOUR INJURY OR ILLNESS
      old_name: injury_illness_section_continuation_txt
      adjudicated: proposed
      judged: 'kept: 3 -> 3'
