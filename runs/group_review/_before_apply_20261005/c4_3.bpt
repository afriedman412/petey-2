      - 566.9860229492188
      - 33.83697509765625
      widget_type: text
      path: topmostSubform[0].#subform[5].DateOfInjury[1]
    description: Date of Injury or Illness. If full date is not known, enter Month/Year
      or Year
    x_petey_description_source: tooltip
    x_petey_xfa:
      kind: date
      join: shape
      pictures:
        format: *id001
    label_source: llm
    pattern: ^(?:\d{1,2}[/\-]\d{1,2}[/\-]\d{4}|\d{1,2}[/\-]\d{4}|\d{4})$
    x_petey_retype:
    - month_year_by_tooltip
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      reason: XFA picture date{MM/DD/YYYY} with tooltip permitting Month/Year or Year;
        pattern must accept a full date too.
      before:
        type: string
        pattern: ^(?:\d{1,2}[/\-]\d{4}|\d{4}[/\-]\d{1,2})$
        description: Date of Injury or Illness. If full date is not known, enter Month/Year
          or Year
      judged: 'kept: 1 -> 1'
