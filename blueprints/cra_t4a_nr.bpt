    x_petey_retype:
    - separators_dropped_by_maxlen:15
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      reason: Character class [AZaz] is a malformed range; XFA picture text{999999999
        AA 9999} calls for two letters, so the class should be [A-Za-z].
      before:
        type: string
        semantic_type: account_number
        pattern: ^\d{9}[AZaz]{2}\d{4}$
        description: Slip 1. Payer’s account number.
