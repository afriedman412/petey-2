    x_petey_adjudication:
      verdict: proposed
      proposed: medical_professional_province
      reason: Caption 'Province' indicates a geographic region, not a person's name;
        the _nm suffix in the current name implies a person/entity name, making the
        proposed name 'medical_professional_province' (without _nm) the better fit.
      model: claude-sonnet-4-6
      contested: the page check says the name or type does not fit the box
    x_petey_review:
      model: claude-opus-5
      changed:
      - -semantic_type
      - name
      reason: 'Caption and tooltip both say Province: the box holds a geographic region,
        so the person_name semantic type and the _nm suffix are wrong.'
      before:
        type: string
        semantic_type: person_name
        description: Part 2. Certifying Medical Professional Information. 2. Certifying
          Medical Professional's Business Address. Enter Province.
      old_name: medical_professional_province_nm
      adjudicated: proposed
      judged: 'kept: 0 -> 0'
    x_petey_hand_edit:
      when: '2026-10-16 12:51:28'
      from:
