  preparer_daytime_phone_nbr:
    x_petey_id: '9_4'
    type: string
    semantic_type: phone
    pattern: ^[0-9]{1,15}$
    widget:
      page: 9
      rect:
      - 60.00899887084961
      - 227.9990234375
      - 300.3810119628906
      - 245.9990234375
      widget_type: text
      path: form1[0].P11[0].Pt7Line4_DaytimeTelephoneNum[0]
    description: Part 7. Contact Information, Declaration, and Signature of the Person
      Preparing this Declaration, if Other Than the Individual Agreeing to Financially
      Support the Beneficiary. Preparer's Contact Information. 3. Preparer's Daytime
      Telephone Number.
    x_petey_description_source: tooltip
    x_petey_validation_source: xfa
    x_petey_xfa:
      kind: text
      picture: text{999999999999999}
      pictures:
        format:
        - text{999999999999999}
        ui:
        - text{999999999999999}
    label_source: llm
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      reason: Box holds a telephone number up to 15 digits (maxlen 15, XFA picture
        999999999999999); the fixed-15-digit pattern is wrong since shorter US numbers
        are normal. Name and type fit the caption 'Preparer's Daytime Telephone Number'.
      before:
        type: string
        semantic_type: phone
        pattern: ^\d{15}$
        description: Part 7. Contact Information, Declaration, and Signature of the
          Person Preparing this Declaration, if Other Than the Individual Agreeing
          to Financially Support the Beneficiary. Preparer's Contact Information.
          3. Preparer's Daytime Telephone Number.
      judged: 'kept: 1 -> 1'
    x_petey_hand_edit:
      when: '2026-10-16 13:27:46'
      from:
        name: preparer_daytime_phone_number
        type: string
        semantic_type: phone
        pattern: ^[0-9]{1,15}$
      to:
        name: preparer_daytime_phone_nbr
        type: string
        semantic_type: phone
        pattern: ^[0-9]{1,15}$
      record: eval/standardize_names.py
      by: claude
      kind: name
      why: 'naming standard: number -> nbr'
