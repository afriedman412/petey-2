    x_petey_adjudication:
      verdict: proposed
      proposed: physical_address_apt_ind
      reason: The red-outlined box is a checkbox under the 'Apt.' label in 'Apt. Ste.
        Flr.' — a filer checks it if the unit type is Apartment, making it a yes/no
        indicator; 'physical_address_apt_ind' (_ind = checkbox/indicator) fits, while
        'physical_address_unit_type' implies a category value rather than a single
      model: claude-sonnet-4-6
      contested: no caption could be verified at the widget
    x_petey_review:
      model: claude-opus-5
      changed:
      - type
      - description
      - -values
      - name
      reason: The widget is a single checkbox and the publisher's tooltip says 'Check
        this box for Apartment', so it holds one yes/no mark, not a three-way unit
        type; name and type must say checkbox for Apt., with separate boxes for Ste.
        and Flr.
      before:
        type: category
        values:
        - apt
        - flr
        - ste
        description: Part 2. Information About the Individual Agreeing to Financially
          Support the Beneficiary. 5. Current Physical Address. Check this box for
          Apartment.
      old_name: physical_address_unit_type
      adjudicated: proposed
      judged: 'kept: 2 -> 0'
    values:
    - apt
    - ste
    - flr
    x_petey_hand_edit:
      when: '2026-10-21 13:42:01'
      from:
        name: physical_address_apt_ind
        type: category
        semantic_type: null
        pattern: null
      to:
        name: physical_address_unit_type
        type: category
        semantic_type: null
        pattern: null
      record: petey/validate/form_chat.py
      by: claude
      kind: chat
      why: 'block type BT3: the type''s wording'
    x_petey_grouping:
