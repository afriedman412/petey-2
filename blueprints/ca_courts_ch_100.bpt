      model: claude-opus-5
      changed:
      - type
      - description
      - -values
      - name
      reason: The widget is a single check-all-that-apply checkbox whose tooltip reads
        'The person in 2 resides in this county'; it holds one independent yes/no
        mark, not a choice among four venue reasons, so a boolean indicator named
        for this reason fits the box.
      before:
        type: category
        values:
        - filer_resides_or_located_in_county
        - harassed_in_county
        - other
        - person_resides_in_county
        description: The person in 2 resides in this county.
      old_name: venue_reason
      adjudicated: proposed
      judged: 'kept: 0 -> 0'
    values:
    - person_resides_in_county
    - harassed_in_county
    - filer_resides_or_located_in_county
    - other
