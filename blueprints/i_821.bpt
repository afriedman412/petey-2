  weight_lbs_digit_txt_2:
    x_petey_id: '4_5'
    type: string
    widget:
      page: 4
      rect:
      - 264.2489929199219
      - 101.9990234375
      - 276.24798583984375
      - 119.9990234375
      widget_type: text
      path: form1[0].Page04[0].Page04[0].Pt2Line4_HeightInches2[0]
    description: Part 2. Biographic Information. Item 4. Weight in pounds - second
      digit. Single digit box; enter the second digit of your weight in pounds (enter
      "000" if unknown or under 30/over 699 pounds).
    x_petey_description_source: tooltip
    label_source: llm
    pattern: ^[0-9]$
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      - description
      - name
      reason: 'The box is a one-character widget holding only the second digit of
        the weight (tooltip: "Pounds. Enter second digit."). The bare name weight_lbs
        cannot be told apart from the sibling single-digit boxes, so a by-name reader
        picks the wrong box. Naming it for the digit it holds and adding the single-d'
      before:
        type: string
        description: Part 2. Biographic Information. 4. Weight. Enter your weight
          in pounds. If you do not know your weight, or need to enter a weight under
          30 pounds or over 699 pounds, enter "000". Do not enter your weight in kilograms.
          Pounds. Enter second digit.
      old_name: weight_lbs
      judged: 'kept: 3 -> 1'
    x_petey_hand_edit:
      when: '2026-10-16 13:47:04'
      from:
        name: weight_lbs_digit2
        type: string
        semantic_type: null
        pattern: ^[0-9]$
      to:
        name: weight_lbs_digit_2_txt
        type: string
        semantic_type: null
        pattern: ^[0-9]$
      record: eval/standardize_names.py
      by: claude
      kind: name
      why: 'naming standard: number split off; +_txt (type); number moved before the
        suffix'
    x_petey_identifiers:
      subject: weight_lbs_digit
      suffix: txt
      iteration: '2'
  weight_lbs_digit_txt_1:
    x_petey_id: '4_4'
    type: string
    widget:
      page: 4
      rect:
      - 246.24899291992188
      - 101.9990234375
      - 258.24798583984375
      - 119.9990234375
      widget_type: text
      path: form1[0].Page04[0].Page04[0].Pt2Line4_HeightInches1[0]
    description: Part 2. Biographic Information. Item 4. Weight in pounds - first
      digit. Single digit box; enter the first digit of your weight in pounds (enter
      "000" if unknown or under 30/over 699 pounds).
    x_petey_description_source: tooltip
    label_source: llm
    pattern: ^[0-9]$
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      - description
      - name
      reason: One-character widget holding the first digit of the weight per the publisher
        tooltip ("Pounds. Enter first digit."). The suffix _2 wrongly implies the
        second digit and does not distinguish the box; naming it for the digit position
        with a single-digit pattern resolves the reader confusion.
      before:
        type: string
        description: Part 2. Biographic Information. 4. Weight. Enter your weight
          in pounds. If you do not know your weight, or need to enter a weight under
          30 pounds or over 699 pounds, enter "000". Do not enter your weight in kilograms.
          Pounds. Enter first digit.
      old_name: weight_lbs_2
      judged: 'kept: 3 -> 0'
    x_petey_hand_edit:
      when: '2026-10-16 13:47:04'
      from:
        name: weight_lbs_digit1
        type: string
        semantic_type: null
        pattern: ^[0-9]$
      to:
        name: weight_lbs_digit_1_txt
        type: string
        semantic_type: null
        pattern: ^[0-9]$
      record: eval/standardize_names.py
      by: claude
      kind: name
      why: 'naming standard: number split off; +_txt (type); number moved before the
        suffix'
    x_petey_identifiers:
      subject: weight_lbs_digit
      suffix: txt
      iteration: '1'
