    x_petey_xfa:
      kind: date
      pictures:
        format:
        - time{h:MM A}
    label_source: llm
    semantic_type: time
    pattern: ^(0?[1-9]|1[0-2]):[0-5][0-9]\s?[APap]\.?[Mm]\.?$
    description: Hearing time
    x_petey_review:
      model: claude-opus-5
      changed:
      - type
      - semantic_type
      - pattern
      - description
      reason: Caption 'Time:' and the XFA picture time{h:MM A} show a time of day,
        not a date; typed as a string with a clock-time pattern. Name already distinguishes
        it from the page 1 hearing time.
      before:
        type: date
      judged: 'kept: 1 -> 1'
    x_petey_hand_edit:
      when: '2026-10-16 13:16:46'
      from:
        name: hearing_time_2
        type: string
        semantic_type: time
        pattern: ^(0?[1-9]|1[0-2]):[0-5][0-9]\s?[APap]\.?[Mm]\.?$
