  do_not_pay_va_compensation_training_pay_ind:
    x_petey_id: '13_11'
    type: boolean
    semantic_type: indicator
    widget:
      page: 13
      rect:
      - 34.9379997253418
      - 287.21099853515625
      - 42.9379997253418
      - 295.21099853515625
      widget_type: checkbox
      path: F[0].#subform[12].Do_NOT_Pay_Me_VA_Compensation_I_Do_Not_Want_To_Receive_VA_Compensation_In_Lieu_Of_Training_Pay[0]
    description: 'IMPORTANT INFORMATION ON INACTIVE DUTY TRAINING PAY: You may elect
      to keep the active or inactive duty training pay you received from the military
      service department. However, to be legally entitled to keep your training pay,
      you must waive V. A. benefits for the number of days equal to the number of
      days for which you received training pay. In most instances, it will be to your
      advantage to waive your V. A. benefits and keep your training pay. If you waive
      V. A. benefits to receive training pay by checking the box in Item 28, V. A.
      will retroactively adjust your V. A. award to withhold benefits equal to the
      total number of training days waived and at the monthly rate in effect for the
      fiscal year period for which you received training pay. This action may result
      in an overpayment of compensation, which may be subject to collection. IMPORTANT:
      V. A. COMPENSATION PAY IS NON-TAXABLE. THEREFORE V. A. COMPENSATION PAY MAY
      BE THE GREATER BENEFIT. 28. Do NOT pay me V. A. compensation. I do NOT want
      to receive V. A. compensation in lieu of training pay.'
    x_petey_description_source: tooltip
    x_petey_retype:
    - description_from_tooltip
    x_petey_hand_edit:
      when: '2026-10-13 12:35:00'
      from:
        name: do_not_pay_va_compensation_ind_2
        type: boolean
        semantic_type: indicator
        pattern: null
      to:
        name: do_not_pay_va_compensation_training_pay_ind
        type: boolean
        semantic_type: indicator
        pattern: null
      record: runs/claude_pass/proposals/lib__vba21526ez.json
      by: claude
      kind: clarity
      why: 'Item 28 under ''IMPORTANT INFORMATION ON INACTIVE DUTY TRAINING PAY'':
        the training-pay election, distinct from the item 26 retired-pay one.'
    x_petey_identifiers:
      subject: do_not_pay_va_compensation_training_pay
      suffix: ind
