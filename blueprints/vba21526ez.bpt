  current_unit_phone_number_txt:
    x_petey_id: '12_32'
    type: string
    semantic_type: phone
    pattern: ^\(?\d{3}\)?[-. ]?\d{3}[-. ]?\d{4}$
    widget:
      page: 12
      rect:
      - 290.8320007324219
      - 324.06201171875
      - 432.6719970703125
      - 347.968994140625
      widget_type: text
      path: F[0].#subform[11].Current_Or_Assigned_Phone_Number_Of_Unit_Include_Area_Code[0]
    description: 21. E. CURRENT OR ASSIGNED PHONE NUMBER OF UNIT (Include Area Code).
    x_petey_description_source: tooltip
    x_petey_retype:
    - description_from_tooltip
    x_petey_review:
      model: claude-opus-5
      changed:
      - pattern
      reason: Free-text box with no comb/maxlen; the publisher only asks for a phone
        number including area code, so the strict 000-000-0000 pattern is over-constrained.
        Widened to accept common area-code formats.
      before:
        type: string
        semantic_type: phone
        pattern: ^\d{3}-\d{3}-\d{4}$
        description: 21. E. CURRENT OR ASSIGNED PHONE NUMBER OF UNIT (Include Area
          Code).
      judged: 'kept: 1 -> 0'
    x_petey_identifiers:
      subject: current_unit_phone_number
      suffix: txt
