    x_petey_validation_source: xfa
    x_petey_xfa:
      kind: text
      picture: text{A9A9A9}
      pictures:
        format:
        - text{A9A9A9}
    label_source: llm
    x_petey_review:
      model: claude-opus-5
      changed:
      - -semantic_type
      reason: Box is the Canadian postal code (caption 'Postal code', maxlen 6, XFA
        picture text{A9A9A9}); name, type and pattern are correct. The 'zip' semantic_type
        made the generator emit a US 5-digit ZIP ('96813'), contradicting the pattern,
        so drop it.
      before:
        type: string
        semantic_type: zip
        pattern: ^[A-Za-z]\d[A-Za-z]\d[A-Za-z]\d$
        description: Part 1. Identification. Postal code. 6 characters.
      judged: 'kept: 1 -> 1'
